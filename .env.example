# Environment variables required by the frontend.
# Copy to .env.local for local development.
# On Vercel: Project Settings -> Environment Variables (add the same keys).

# REQUIRED. Base URL of the Laravel API, including the /api prefix, no trailing
# slash. Must be HTTPS and must NOT be localhost in production --
# next.config.js fails the production build otherwise.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Public origin of this Next.js app. Used for metadataBase / Open Graph URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. Supabase project values, from the Supabase dashboard
# (Project Settings -> API). Only needed where Supabase is used.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
